# Что не должно попасть в образ.
#
# Кроме размера, здесь есть вопрос безопасности: .env с боевым ключом подписи
# внутри образа — это ключ, который уезжает вместе с образом куда угодно.

.git
.gitignore
.venv
**/__pycache__
*.py[cod]

# Секреты. Переменные передаются контейнеру при запуске, а не пекутся в слой.
.env
.env.*
!.env.example
!.env.docker.example

# Локальная база разработки — в контейнере своя, PostgreSQL.
db.sqlite3
*.sqlite3

# Собирается внутри образа командой collectstatic.
staticfiles/

# Временные файлы и скриншоты этапов.
tmp_*
*.log
.claude/
.ruff_cache/

# Сборочные файлы самого Docker.
Dockerfile
.dockerignore
docker-compose*.yml
