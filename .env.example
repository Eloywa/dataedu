# Скопируйте в .env и при необходимости поменяйте значения. .env в git не входит.
#
# Со значениями по умолчанию проект поднимается на файловой базе SQLite — без
# установки СУБД. Всё, что ниже, нужно только когда что-то отличается от этого.

# --- Общее ------------------------------------------------------------------
# dev (по умолчанию) — разработка и защита; prod — эксплуатация.
DJANGO_ENV=dev

# В разработке годится любое значение. Профиль prod откажется стартовать с
# отладочным или коротким ключом: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=django-insecure-smenite-menya-v-ekspluatacii

DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# --- База данных ------------------------------------------------------------
# Пусто или sqlite — файловая база db.sqlite3 (по умолчанию в разработке).
# postgres — подключение по параметрам ниже. В профиле prod PostgreSQL обязателен.
DB_ENGINE=

DB_NAME=dataedu_django
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Время жизни соединения с БД, сек. Ноль — переподключаться на каждый запрос.
DB_CONN_MAX_AGE=60

# --- Нагрузка ---------------------------------------------------------------
# Размер страницы в каталоге и очереди проверки.
PAGE_SIZE=24

# Сколько секунд держать посчитанные отчёты преподавателя. 0 — не кэшировать.
REPORT_CACHE_SECONDS=60

# Общий кэш и сессии для нескольких рабочих процессов (только prod).
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Правовой контур --------------------------------------------------------
# На апробации свободную регистрацию закрывают, логины выдают командой
# create_pilot_accounts.
REGISTRATION_OPEN=1

# Срок хранения событий ленты активности, дней. Чистка — manage.py purge_metrics.
METRICS_RETENTION_DAYS=400

# --- Только эксплуатация ----------------------------------------------------
# Выключить, если контур внутренний и HTTPS нет.
# SECURE_SSL=1
# CSRF_TRUSTED_ORIGINS=https://dataedu.example.ru
# SECURE_HSTS_SECONDS=0
# LOG_LEVEL=INFO
