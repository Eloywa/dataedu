# Окружение для развёртывания в Docker. Скопируйте в .env.docker и заполните.
#
#   cp .env.docker.example .env.docker
#
# Имя отдельное намеренно: .env остаётся под разработку на SQLite, и
# развёртывание в контейнерах его не затирает.
#
# Отличия от .env.example (профиль разработки): база — PostgreSQL из контейнера,
# профиль prod задаётся в docker-compose.yml, а SECRET_KEY обязан быть настоящим.

# --- Обязательное ------------------------------------------------------------

# Профиль prod откажется стартовать с коротким или отладочным ключом.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Домен или IP сервера. Пустой список при DEBUG=False — отказ обслуживать
# запросы; это лучше, чем принимать любые, но сайт не откроется.
ALLOWED_HOSTS=dataedu.example.ru,www.dataedu.example.ru

# Пароль базы. Им же создаётся пользователь PostgreSQL при первом запуске
# контейнера db — потом сменить его можно только внутри самой базы.
DB_PASSWORD=

# --- База данных -------------------------------------------------------------
# DB_HOST и DB_PORT задаёт compose (сервис db) — здесь их указывать не нужно.

DB_NAME=dataedu_django
DB_USER=dataedu
DB_CONN_MAX_AGE=60

# --- HTTPS -------------------------------------------------------------------
#
# ВАЖНО. По умолчанию профиль prod переадресует всё на https. Пока сертификата
# нет и nginx слушает только 80, это даёт бесконечную переадресацию, и сайт не
# открывается вовсе. На время настройки поставьте 0, после выпуска сертификата
# верните 1 и добавьте домен в CSRF_TRUSTED_ORIGINS.
SECURE_SSL=0

# CSRF_TRUSTED_ORIGINS=https://dataedu.example.ru

# HSTS включать только после того, как HTTPS устойчиво работает: заголовок с
# большим сроком на домене без постоянного HTTPS быстро откатить нельзя.
SECURE_HSTS_SECONDS=0

# --- Прочее ------------------------------------------------------------------

PAGE_SIZE=24
REPORT_CACHE_SECONDS=60
REGISTRATION_OPEN=1
METRICS_RETENTION_DAYS=400
LOG_LEVEL=INFO

# Общий кэш и сессии, если рабочих процессов несколько. Требует контейнера redis
# и `pip install redis` — в базовый образ он не входит.
# REDIS_URL=redis://redis:6379/0

# Миграции применяются при старте контейнера. Поставьте 0, если хотите
# запускать их отдельным шагом выката.
RUN_MIGRATIONS=1
